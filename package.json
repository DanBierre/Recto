{
  "name": "recto",
  "productName": "Recto",
  "version": "0.1.0",
  "description": "A small, quiet text editor.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "start": "node build.js && electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "node build.js && electron-builder --win && node build/setup.js",
    "check": "node build.js && node tests/app-check.mjs",
    "icon": "electron scripts/icon.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "marked": "^18.2.0",
    "playwright-core": "^1.57.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "nz.dan.recto",
    "productName": "Recto",
    "files": [
      "main.js",
      "preload.js",
      "encoding.js",
      "zip.js",
      "winmenu.js",
      "index.html",
      "dist/**",
      "assets/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Recto",
      "createDesktopShortcut": false,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "log",
          "ini",
          "cfg",
          "conf",
          "env"
        ],
        "name": "Text",
        "role": "Editor"
      },
      {
        "ext": [
          "js",
          "mjs",
          "cjs",
          "ts",
          "tsx",
          "jsx",
          "json",
          "css",
          "html",
          "xml",
          "yml",
          "yaml",
          "toml",
          "py",
          "rs",
          "go",
          "sh",
          "ps1",
          "sql",
          "csv"
        ],
        "name": "Code",
        "role": "Editor"
      }
    ]
  }
}
